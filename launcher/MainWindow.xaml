<Window x:Class="RvcLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RvcLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RVC Dataset Studio" Width="1120" Height="690" MinWidth="850" MinHeight="560"
        Icon="Assets/RvcLauncher.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#111627" Foreground="#F2F5FF" FontFamily="Segoe UI, Microsoft YaHei UI, Yu Gothic UI"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button" x:Key="Action">
            <Setter Property="Foreground" Value="#F2F5FF" />
            <Setter Property="Background" Value="#2C354D" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#9AB2FC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource Action}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="#3C4667" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#151B2E" BorderBrush="#303A56" BorderThickness="0,0,1,0">
                <Grid Margin="8,13">
                    <Border Width="40" Height="38" CornerRadius="11" Background="#A9BEFF" VerticalAlignment="Top">
                        <Path Data="M 4,10 L 9,10 L 13,2 L 18,17 L 23,7 L 29,7"
                              Stroke="#151B32" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="0,63,0,0">
                        <Border Background="#313D5C" CornerRadius="9" Padding="0,9" Margin="1,0,1,9">
                            <TextBlock Text="RVC" FontWeight="Bold" FontSize="12" Foreground="#C9D6FF" HorizontalAlignment="Center" />
                        </Border>
                        <Button x:Name="RailSettings" Style="{StaticResource IconButton}" Click="OpenSettings"
                                HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" />
                    </StackPanel>
                    <TextBlock Text="01" FontSize="10" Foreground="#93A2CA" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Grid x:Name="WallpaperHost" Grid.Column="1" ClipToBounds="True">
                <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
                    <Canvas Width="1100" Height="680">
                        <Rectangle Width="1100" Height="680">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#171D46" Offset="0" />
                                    <GradientStop Color="#38437C" Offset="0.5" />
                                    <GradientStop Color="#788AD1" Offset="0.78" />
                                    <GradientStop Color="#202D55" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse Canvas.Left="506" Canvas.Top="0" Width="536" Height="475">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#D09AC6FF" Offset="0" />
                                    <GradientStop Color="#4496BCFF" Offset="0.52" />
                                    <GradientStop Color="#0096BCFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="666" Canvas.Top="110" Width="215" Height="215" Fill="#CFDDFF" Opacity="0.9" />
                        <Ellipse Canvas.Left="687" Canvas.Top="127" Width="173" Height="173" Stroke="#E6EDFF" StrokeThickness="2" Opacity="0.6" />
                        <Ellipse Canvas.Left="633" Canvas.Top="168" Width="285" Height="108" Stroke="#C0D2FF" StrokeThickness="1" Opacity="0.7"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform Angle="-18" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Path Data="M 0,439 L 127,411 204,449 365,336 465,418 551,369 620,410 711,348 809,428 893,397 1010,327 1100,362 1100,680 0,680 Z"
                              Fill="#445485" />
                        <Path Data="M 0,498 L 111,456 181,476 254,435 388,482 524,433 639,490 744,410 851,458 942,420 1100,453 1100,680 0,680 Z"
                              Fill="#2F3E6B" />
                        <Path Data="M 0,558 L 118,504 234,541 368,486 489,543 604,493 676,549 820,487 973,530 1100,470 1100,680 0,680 Z"
                              Fill="#252F55" />
                        <Path Data="M 0,587 C 273,566 393,642 663,573 C 856,522 974,558 1100,543 L 1100,680 0,680 Z"
                              Fill="#162343" />
                        <Path Data="M 494,651 C 632,640 689,598 856,580 M 733,654 C 830,616 902,608 1005,610"
                              Stroke="#7698DA" StrokeThickness="1.5" Opacity="0.45" />
                        <Path Data="M 508,106 L 508,124 M 499,115 L 517,115 M 972,167 L 972,185 M 963,176 L 981,176
                                    M 918,75 L 918,85 M 913,80 L 923,80 M 612,215 L 612,225 M 607,220 L 617,220"
                              Stroke="#D5E4FF" StrokeThickness="1.5" Opacity="0.8" />
                    </Canvas>
                </Viewbox>
                <local:WallpaperView x:Name="Wallpaper" IsHitTestVisible="False" />
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E4101529" Offset="0" />
                            <GradientStop Color="#84101529" Offset="0.42" />
                            <GradientStop Color="#0A101529" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#9E101529" Offset="0" />
                            <GradientStop Color="#00101529" Offset="0.26" />
                            <GradientStop Color="#00101529" Offset="0.52" />
                            <GradientStop Color="#F011172A" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="27,0,12,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="WallpaperButton" Style="{StaticResource Action}" Click="ChooseWallpaper" Margin="0,0,8,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button x:Name="FitWallpaperButton" Style="{StaticResource Action}" Click="OpenWallpaperEditor" Margin="0,0,8,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button x:Name="ResetWallpaperQuickButton" Style="{StaticResource Action}" Click="ResetWallpaper" Margin="0,0,8,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="−" Click="Minimize"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="×" Click="CloseWindow"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        </StackPanel>
                        <TextBlock Text="RVC  /  DATASET STUDIO" FontSize="13" FontWeight="Bold" Foreground="#E1E7FF" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="41,0,38,32" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <TextBlock x:Name="HeroKicker" FontSize="12" FontWeight="SemiBold" Foreground="#B8CBFF" />
                        <TextBlock x:Name="HeroTitle" FontSize="44" FontWeight="Bold" Margin="0,8,0,8" />
                        <TextBlock x:Name="HeroDescription" FontSize="15" Foreground="#D2D8EC" MaxWidth="440" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="24,0,24,22" Padding="17,14" CornerRadius="14" Background="#ED171E32"
                            BorderBrush="#5C6E9E" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <DockPanel Margin="0,0,13,0">
                                    <Ellipse x:Name="ServiceDot" DockPanel.Dock="Left" Width="8" Height="8" Fill="#95A2C5"
                                             VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ServiceStatus" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock x:Name="UpdateStatus" FontSize="12" Foreground="#BAC7E5" TextWrapping="Wrap" Margin="17,5,13,0" />
                                <Button x:Name="OpenExportsButton" Style="{StaticResource Action}" Click="OpenExports"
                                        HorizontalAlignment="Left" Margin="17,8,8,0" />
                                <ProgressBar x:Name="ServiceProgress" Height="3" Margin="17,7,16,0" IsIndeterminate="True" Visibility="Collapsed"
                                             Foreground="#ACBFFF" Background="#303A58" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ReleaseButton" Style="{StaticResource Action}" Click="ShowUpdate" Visibility="Collapsed" Margin="0,0,8,0" />
                                <Button x:Name="UpdateButton" Style="{StaticResource Action}" Click="CheckUpdates" Margin="0,0,10,0" />
                                <Button x:Name="StopButton" Style="{StaticResource Action}" Click="StopWorkbench"
                                        Visibility="Collapsed" Margin="0,0,10,0" />
                                <Button x:Name="LaunchButton" Style="{StaticResource Action}" Click="Launch"
                                        MinWidth="166" Height="51" FontSize="15" Background="#B5C8FF" Foreground="#10182C" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Background="#B60B1122" Visibility="Collapsed">
                <Border Background="#192138" BorderBrush="#6174A6" BorderThickness="1" CornerRadius="15"
                        Width="508" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="DismissSettingsButton" Style="{StaticResource IconButton}" Content="×" DockPanel.Dock="Right" Click="DismissSettings" />
                            <TextBlock x:Name="SettingsTitle" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox x:Name="AutoUpdateInput" Margin="0,13,0,13" Foreground="#E9EEFF" />
                        <TextBlock x:Name="UpdateSourceLabel" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="UpdateSourceInput" Width="235" HorizontalAlignment="Left" Padding="6,4"
                                  SelectionChanged="UpdateSourceChanged">
                            <ComboBoxItem x:Name="DirectSourceItem" />
                            <ComboBoxItem x:Name="ProxySourceItem" />
                        </ComboBox>
                        <StackPanel x:Name="UpdateProxyPanel" Margin="0,9,0,0" Visibility="Collapsed">
                            <TextBox x:Name="UpdateProxyInput" MaxLength="1024" Padding="7,5" />
                            <TextBlock x:Name="UpdateProxyHelp" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#BAC7E5" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="LanguageLabel" Margin="0,12,0,6" FontWeight="SemiBold" />
                        <ComboBox x:Name="LanguageInput" Width="166" HorizontalAlignment="Left" Padding="6,4">
                            <ComboBoxItem Content="简体中文" Tag="zh" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="日本語" Tag="ja" />
                        </ComboBox>
                        <TextBlock x:Name="SettingsError" Foreground="#FFB2BA" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                        <WrapPanel Margin="0,17,0,0">
                            <Button x:Name="ResetWallpaperButton" Style="{StaticResource Action}" Click="ResetWallpaper" Margin="0,0,8,5" />
                            <Button x:Name="LogButton" Style="{StaticResource Action}" Click="OpenLogs" Margin="0,0,8,5" />
                            <Button x:Name="SaveSettingsButton" Style="{StaticResource Action}" Click="SaveSettings"
                                    Background="#B5C8FF" Foreground="#10182C" Margin="0,0,0,5" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="WallpaperOverlay" Grid.ColumnSpan="2" Background="#B60B1122" Visibility="Collapsed"
                  KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="#192138" BorderBrush="#6174A6" BorderThickness="1" CornerRadius="15"
                        Width="510" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="WallpaperEditorTitle" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="WallpaperFitLabel" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <ComboBox x:Name="WallpaperFitInput" Padding="6,4" SelectionChanged="WallpaperOptionsChanged">
                            <ComboBoxItem x:Name="WallpaperCropItem" />
                            <ComboBoxItem x:Name="WallpaperContainItem" />
                            <ComboBoxItem x:Name="WallpaperStretchItem" />
                        </ComboBox>
                        <CheckBox x:Name="WallpaperAutoStretch" Margin="0,9,0,9" Foreground="#E9EEFF"
                                  Checked="WallpaperOptionsChanged" Unchecked="WallpaperOptionsChanged" />
                        <Border x:Name="WallpaperPreviewHost" Background="#10172A" BorderBrush="#7086BC" BorderThickness="1"
                                HorizontalAlignment="Center" Focusable="True" ClipToBounds="True"
                                MouseLeftButtonDown="BeginWallpaperDrag" MouseMove="DragWallpaper" MouseLeftButtonUp="EndWallpaperDrag"
                                LostMouseCapture="EndWallpaperDrag" KeyDown="PanWallpaperWithKeys">
                            <local:WallpaperView x:Name="WallpaperPreview" IsHitTestVisible="False" />
                        </Border>
                        <TextBlock x:Name="WallpaperHint" Foreground="#B3C1E1" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="CenterWallpaperButton" Style="{StaticResource Action}" Click="CenterWallpaper" Margin="0,0,8,0" />
                            <Button x:Name="CancelWallpaperButton" Style="{StaticResource Action}" Click="CloseWallpaperEditor" Margin="0,0,8,0" />
                            <Button x:Name="SaveWallpaperButton" Style="{StaticResource Action}" Click="SaveWallpaper"
                                    Background="#B5C8FF" Foreground="#10182C" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="UpdateOverlay" Grid.ColumnSpan="2" Background="#D00B1122" Visibility="Collapsed">
                <Border Background="#192138" BorderBrush="#6174A6" BorderThickness="1" CornerRadius="15"
                        Width="610" MaxHeight="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UpdateTitle" FontSize="23" FontWeight="Bold" />
                        <TextBlock x:Name="UpdateVersion" Grid.Row="1" Margin="0,8,0,14" Foreground="#BAC7E5" />
                        <TextBox x:Name="ReleaseNotes" Grid.Row="2" MinHeight="120" MaxHeight="260" Padding="12"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#10172A" Foreground="#EEF2FF" BorderBrush="#6376A5" />
                        <TextBlock x:Name="UpdateHint" Grid.Row="3" TextWrapping="Wrap" Margin="0,12,0,8" Foreground="#BAC7E5" />
                        <ProgressBar x:Name="DownloadProgress" Grid.Row="4" Height="5" Maximum="100" Visibility="Collapsed" />
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button x:Name="CancelUpdateButton" Style="{StaticResource Action}" Click="DismissUpdate" Margin="0,0,8,0" />
                            <Button x:Name="InstallUpdateButton" Style="{StaticResource Action}" Click="InstallUpdate"
                                    Background="#B5C8FF" Foreground="#10182C" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
